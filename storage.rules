rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Resumes folder
    match /resumes/{fileName} {
      allow read: if request.auth != null;
      allow write: if true; // Allows candidates to upload during registration/application
    }
    
    // Invoices folder
    match /invoices/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Documents & general uploads
    match /documents/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Public assets / images
    match /public/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fallback default
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
