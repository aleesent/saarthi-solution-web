# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE DATABASE & STORAGE CONFIGURATION
# ==============================================================================
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=""

# Supabase public anonymous key (safe for client queries)
SUPABASE_ANON_KEY=""

# Supabase service role secret key (used strictly server-side for backend operations)
SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# STORAGE ARCHITECTURE RULES:
# 1. PDF / Resumes / Invoices / Documents -> ALWAYS Google Drive (Regardless of file size)
# 2. Small UI Assets / Logos / Website Graphics -> Supabase Storage ('assets' bucket)
# 3. Structured Data / Forms / Applications / Messages -> Supabase PostgreSQL Tables
# ==============================================================================

# ==============================================================================
# GOOGLE DRIVE API STORAGE CONFIGURATION
# ==============================================================================
# Google Cloud Console OAuth 2.0 Client ID (Web Application or Service Account)
GOOGLE_DRIVE_CLIENT_ID=""

# Google Cloud Console OAuth 2.0 Client Secret
GOOGLE_DRIVE_CLIENT_SECRET=""

# Google OAuth 2.0 Refresh Token with Drive scope (https://www.googleapis.com/auth/drive)
GOOGLE_DRIVE_REFRESH_TOKEN=""

# Google Drive Root Folder ID where all website files & categorized subfolders are stored
# (e.g. "1aBcD_EFgHiJkLmNoPqRsTuVwXyZ" from folder URL: drive.google.com/drive/folders/FOLDER_ID)
GOOGLE_DRIVE_FOLDER_ID=""

# Optional custom OAuth redirect URI (defaults to https://YOUR_APP_URL/auth/google/callback)
GOOGLE_REDIRECT_URI=""

# Optional flag to lock down the OAuth setup endpoint in production
DISABLE_GOOGLE_OAUTH_SETUP="false"
